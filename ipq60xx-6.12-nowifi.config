# ============================================================
# ZN-M2 (IPQ6000) · 无 WiFi · OpenClash 专用固件配置
# 适用源码树：LiBwrt/openwrt-6.x @ 25.12-nss（内核 6.12 + NSS，apk 包管理）
# 用法：cp 本文件 .config → bash diy_script.sh → make defconfig → make
# 注意：CONFIG_TARGET_ROOTFS_INITRAMFS=n，若需 initramfs 镜像刷机请改为 y
# ============================================================
### INITIALIZATION ###
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_MULTI_PROFILE=n
# 如需通过 U-Boot 直接刷 initramfs 镜像（ZN-M2 常见刷机方式），请改为 y
CONFIG_TARGET_ROOTFS_INITRAMFS=n
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_zn_m2=y

#
# Target Devices
#
# CONFIG_TARGET_ALL_PROFILES is not set
# CONFIG_TARGET_PER_DEVICE_ROOTFS is not set
# CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_8devices_mango-dvk is not set
# CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_cambiumnetworks_xe3-4 is not set
# CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_cmiot_ax18 is not set
# CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_glinet_gl-ax1800 is not set
# CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_glinet_gl-axt1800 is not set
# CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_ax1800-pro is not set
# CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_ax6600 is not set
# CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-07 is not set
# CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_linksys_mr7350 is not set
# CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_netgear_wax214 is not set
# CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_qihoo_v6 is not set
# CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_redmi_ax5 is not set
# CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_redmi_ax5-jdcloud is not set
# CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_xiaomi_ax1800 is not set
# CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_yuncore_fap650 is not set
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_zn_m2=y
# end of Target Devices

#
# General build options
#
CONFIG_USE_APK=y

#
# Kernel build options
#
CONFIG_KERNEL_ARM_PMU=y
CONFIG_KERNEL_CFQ_GROUP_IOSCHED=y             # CFQ 组 I/O 调度器
CONFIG_KERNEL_CGROUP_DEVICE=y                 # Cgroup 设备控制
CONFIG_KERNEL_CGROUP_FREEZER=y                # Cgroup 冻结器
CONFIG_KERNEL_CGROUP_HUGETLB=n                # 禁用 Cgroup 大页（Docker已移除，不需要）
CONFIG_KERNEL_CGROUP_NET_PRIO=y               # Cgroup 网络优先级
CONFIG_KERNEL_CGROUP_PERF=y                   # Cgroup 性能事件
CONFIG_KERNEL_HUGETLBFS=n                     # 禁用大页文件系统（Docker已移除）
CONFIG_KERNEL_HUGETLB_PAGE=n                  # 禁用大页支持（Docker已移除）
CONFIG_KERNEL_MEMCG_SWAP_ENABLED=n            # 禁用 Swap（路由器通常不需要）
CONFIG_KERNEL_NET_CLS_CGROUP=y                # 网络分类 Cgroup
CONFIG_KERNEL_PERF_EVENTS=y                   # 性能事件支持
CONFIG_KERNEL_PREEMPT_RCU=n                   # 禁用抢占式 RCU
CONFIG_KERNEL_TRANSPARENT_HUGEPAGE=n          # 禁用透明大页（Docker已移除）
CONFIG_KERNEL_TRANSPARENT_HUGEPAGE_ALWAYS=n   # 禁用透明大页（Docker已移除）
CONFIG_KERNEL_IPV6=y

# ============================================================
# NSS 硬件加速（qca-nss-drv 系列，IPQ6000 特色，由 25.12-nss 分支提供）
# 若 make defconfig 报 "No rule to make target kmod-qca-nss-drv-*"，
# 说明源码树不含 NSS 包（确认 REPO_BRANCH=25.12-nss），删除本段可退回软转发。
# ============================================================
CONFIG_NSS_DRV_IGS_ENABLE=y                   # NSS IGS 支持
CONFIG_NSS_DRV_MAPT_ENABLE=y                  # NSS MAP-T 支持
CONFIG_NSS_DRV_PPTP_ENABLE=y                  # NSS PPTP 支持
CONFIG_NSS_DRV_SHAPER_ENABLE=y                # NSS 流量整形支持
CONFIG_NSS_DRV_WIFIOFFLOAD_ENABLE=n           # 禁用 NSS WiFi 卸载（nowifi）
CONFIG_NSS_FIRMWARE_VERSION_12_2=y            # NSS 固件版本 12.2
CONFIG_NSS_FIRMWARE_VERSION_12_5=n            # 禁用版本 12.5

#
# Base system
#
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_dropbear=y
CONFIG_DEFAULT_ipv6helper=y

CONFIG_PACKAGE_apk-mbedtls=y
# CONFIG_PACKAGE_apk-openssl is not set
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_cgi-io=y
CONFIG_PACKAGE_cgroupfs-mount=y
CONFIG_PACKAGE_chinadns-ng=n
CONFIG_PACKAGE_containerd=n
CONFIG_PACKAGE_coremark=n
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_default-settings=y
CONFIG_PACKAGE_default-settings-chn=y
CONFIG_PACKAGE_dns2socks=n
CONFIG_PACKAGE_docker=n
CONFIG_PACKAGE_docker-compose=n
CONFIG_PACKAGE_dockerd=n
CONFIG_PACKAGE_etherwake=n
CONFIG_PACKAGE_fdisk=n
# 老 iptables 版防火墙已弃用，改 firewall4（nftables）
# CONFIG_PACKAGE_firewall is not set
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_hostapd=n
CONFIG_PACKAGE_hostapd-common=n

# ---- OpenClash 运行依赖（显式声明更可控；luci-app-openclash=y 时依赖解析也会自动补齐） ----
CONFIG_PACKAGE_bash=y                         # OpenClash 脚本为 bash 编写
CONFIG_PACKAGE_coreutils-nohup=y              # 后台守护进程
CONFIG_PACKAGE_coreutils-timeout=y            # 超时控制
CONFIG_PACKAGE_libcap-bin=y                   # capsh，OpenClash 权限处理
CONFIG_PACKAGE_iptables-mod-tproxy=y          # TPROXY 透明代理（iptables 侧）
CONFIG_PACKAGE_kmod-ipt-tproxy=y              # xt_TPROXY 内核模块
CONFIG_PACKAGE_dnsmasq-full=y                 # nftset/ipset 支持（OpenClash DNS 劫持需要；若改用 OxiDNS 做上游也兼容）
CONFIG_PACKAGE_zoneinfo-asia=y                # Asia/Shanghai 时区数据（LuCI 时区设置必需）

CONFIG_PACKAGE_ip-full=y                      # 完整版 IP 工具（OpenClash Tun 模式需要）
CONFIG_PACKAGE_ip-tiny=n                      # 禁用精简版
CONFIG_PACKAGE_ip6tables=y
# CONFIG_PACKAGE_ip6tables-extra is not set
CONFIG_PACKAGE_ip6tables-mod-nat=y
CONFIG_PACKAGE_ip6tables-nft=y                # IPv6 防火墙 (nftables)
CONFIG_PACKAGE_iptables=y
CONFIG_PACKAGE_iptables-mod-extra=y           # iptables 扩展模块
CONFIG_PACKAGE_iptables-nft=y                 # iptables (nftables 后端)
CONFIG_PACKAGE_xtables-nft=y                  # xtables-nft 工具

# CONFIG_PACKAGE_ipq-wifi-cmiot_ax18 is not set
# CONFIG_PACKAGE_ipq-wifi-glinet_gl-ax1800 is not set
# CONFIG_PACKAGE_ipq-wifi-glinet_gl-axt1800 is not set
# CONFIG_PACKAGE_ipq-wifi-jdcloud_re-cs-02 is not set
# CONFIG_PACKAGE_ipq-wifi-jdcloud_re-ss-01 is not set
# CONFIG_PACKAGE_ipq-wifi-qihoo_v6 is not set
# CONFIG_PACKAGE_ipq-wifi-redmi_ax5 is not set
# CONFIG_PACKAGE_ipq-wifi-redmi_ax5-jdcloud is not set
# CONFIG_PACKAGE_ipq-wifi-xiaomi_ax1800 is not set
# CONFIG_PACKAGE_ipq-wifi-zn_m2 is not set

# CONFIG_PACKAGE_iw is not set
# CONFIG_PACKAGE_iwinfo is not set

# 网络转发 / 透明代理内核模块（OpenClash 运行依赖）
CONFIG_PACKAGE_kmod-br-netfilter=y            # 网桥 netfilter
CONFIG_PACKAGE_kmod-dummy=y                   # 虚拟网络设备
CONFIG_PACKAGE_kmod-ifb=y                     # IFB 虚拟网络设备
CONFIG_PACKAGE_kmod-inet-diag=y               # 网络诊断
CONFIG_PACKAGE_kmod-ip6tables=y               # IPv6 防火墙表
CONFIG_PACKAGE_kmod-ipt-conntrack=y           # 连接跟踪
CONFIG_PACKAGE_kmod-ipt-core=y                # iptables 核心
CONFIG_PACKAGE_kmod-ipt-extra=y               # iptables 扩展
CONFIG_PACKAGE_kmod-ipt-nat=y                 # NAT 支持
CONFIG_PACKAGE_kmod-ipt-nat6=y                # IPv6 NAT
CONFIG_PACKAGE_kmod-ipt-physdev=y             # 物理设备匹配
CONFIG_PACKAGE_kmod-macvlan=n                 # 禁用 MACVLAN（Docker macvlan，已移除）
CONFIG_PACKAGE_kmod-nat46=y                   # NAT46 转换
CONFIG_PACKAGE_kmod-netlink-diag=y            # Netlink 诊断
CONFIG_PACKAGE_kmod-nf-ipt=y                  # Netfilter IPv4
CONFIG_PACKAGE_kmod-nf-ipt6=y                 # Netfilter IPv6
CONFIG_PACKAGE_kmod-nf-ipvs=n                 # 禁用 IPVS（Docker负载均衡，已移除）
CONFIG_PACKAGE_kmod-nf-nat6=y                 # IPv6 NAT
CONFIG_PACKAGE_kmod-nf-tproxy=y               # 透明代理（nftables 侧）
CONFIG_PACKAGE_kmod-nft-compat=y              # nftables 兼容层
CONFIG_PACKAGE_kmod-nft-tproxy=y              # nftables 透明代理
CONFIG_PACKAGE_kmod-sched-core=y              # 流量调度核心
CONFIG_PACKAGE_kmod-tun=y                     # TUN/TAP 设备
CONFIG_PACKAGE_kmod-veth=n                    # 禁用 veth（Docker容器网络，已移除）
CONFIG_PACKAGE_kmod-wireguard=n               # 禁用 WireGuard VPN

# NSS 驱动
CONFIG_PACKAGE_kmod-qca-mcs=y                 # QCA 多播转发
CONFIG_PACKAGE_kmod-qca-nss-drv-igs=y         # NSS IGS 驱动
CONFIG_PACKAGE_kmod-qca-nss-drv-map-t=y       # NSS MAP-T 驱动
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y       # NSS PPPoE 驱动
CONFIG_PACKAGE_kmod-qca-nss-drv-pptp=y        # NSS PPTP 驱动
CONFIG_PACKAGE_kmod-qca-nss-drv-qdisc=y       # NSS QDisc 驱动
CONFIG_PACKAGE_kmod-qca-nss-macsec=y          # NSS MACsec 驱动

# WiFi 全禁用（nowifi）
CONFIG_PACKAGE_kmod-ath=n
CONFIG_PACKAGE_kmod-ath11k=n
CONFIG_PACKAGE_kmod-ath11k-ahb=n
CONFIG_PACKAGE_kmod-ath11k-pci=n
CONFIG_PACKAGE_ath11k-firmware-ipq6018=n
CONFIG_PACKAGE_ath11k-firmware-ipq6018-ddwrt=n
CONFIG_PACKAGE_ath11k-firmware-qcn9074=n
CONFIG_PACKAGE_ath11k-firmware-qcn9074-ddwrt=n

# 文件系统支持 (已禁用)
CONFIG_PACKAGE_btrfs-progs=n                  # 禁用 Btrfs 文件系统工具
CONFIG_PACKAGE_kmod-fs-btrfs=n                # 禁用 Btrfs 内核模块
CONFIG_PACKAGE_kmod-scsi-core=n               # 禁用 SCSI 核心支持
CONFIG_PACKAGE_mount-utils=n                  # 禁用挂载工具

# USB 支持 (已禁用；若需 U 盘扩展存储，请启用 kmod-usb-storage/kmod-usb3/block-mount)
CONFIG_PACKAGE_kmod-usb-dwc2=n                # 禁用 DWC2 USB 控制器
CONFIG_PACKAGE_kmod-usb-dwc2-pci=n            # 禁用 DWC2 PCI 版本
CONFIG_PACKAGE_kmod-usb-ehci=n                # 禁用 EHCI USB 2.0 主控制器
CONFIG_PACKAGE_kmod-usb-ohci=n                # 禁用 OHCI USB 1.1 主控制器
CONFIG_PACKAGE_kmod-usb-phy-nop=n             # 禁用 USB PHY
CONFIG_PACKAGE_kmod-usb-roles=n               # 禁用 USB 角色切换
CONFIG_PACKAGE_kmod-usb-storage=n             # 禁用 USB 存储支持
CONFIG_PACKAGE_kmod-usb-storage-extras=n      # 禁用 USB 存储扩展
CONFIG_PACKAGE_kmod-usb-uhci=n                # 禁用 UHCI USB 控制器
CONFIG_PACKAGE_kmod-usb2=n                    # 禁用 USB 2.0 支持
CONFIG_PACKAGE_kmod-usb2-pci=n                # 禁用 USB 2.0 PCI 支持

# 系统库文件
CONFIG_PACKAGE_libattr=y                      # 扩展属性库
CONFIG_PACKAGE_libcap=y                       # POSIX 能力库
CONFIG_PACKAGE_libcap-ng=n                    # 禁用下一代能力库（libcap已够用）
CONFIG_PACKAGE_libiptext=y                    # iptables 文本库
CONFIG_PACKAGE_libiptext-nft=y                # nftables 文本库
CONFIG_PACKAGE_libiptext6=y                   # IPv6 文本库
CONFIG_PACKAGE_liblua=y                       # Lua 脚本库
CONFIG_PACKAGE_liblucihttp=y                  # LuCI HTTP 库
CONFIG_PACKAGE_liblucihttp-lua=y              # LuCI HTTP Lua 绑定
CONFIG_PACKAGE_liblucihttp-ucode=y            # LuCI HTTP ucode 绑定
CONFIG_PACKAGE_libmount=n                     # 禁用挂载库（文件系统相关）
CONFIG_PACKAGE_libncurses=n                   # NCurses 终端库
CONFIG_PACKAGE_libseccomp=n                   # 禁用 Seccomp（Docker专用，已移除）
CONFIG_PACKAGE_libubus-lua=y                  # ubus Lua 绑定
CONFIG_PACKAGE_libuv=y                        # 异步 I/O 库
CONFIG_PACKAGE_libwebsockets-full=y           # WebSockets 库
CONFIG_PACKAGE_libxtables=y                   # xtables 库
CONFIG_PACKAGE_libmbedtls=y                   # mbedTLS 加密库

#
# LuCI
#
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-app-argon-config=n
CONFIG_PACKAGE_luci-app-dockerman=n
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-homeproxy=n
CONFIG_PACKAGE_luci-app-openclash=y           # OpenClash（由 diy_script.sh clone 源码）
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-passwall=n
CONFIG_PACKAGE_luci-app-smartdns=n
CONFIG_PACKAGE_luci-app-ttyd=n
CONFIG_PACKAGE_luci-app-upnp=n
CONFIG_PACKAGE_luci-app-wol=n
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=n
CONFIG_PACKAGE_luci-i18n-dockerman-zh-cn=n
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-homeproxy-zh-cn=n
CONFIG_PACKAGE_luci-i18n-openclash-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn=n
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=n
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=n
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=n
CONFIG_PACKAGE_luci-lib-base=y
CONFIG_PACKAGE_luci-lib-docker=n
CONFIG_PACKAGE_luci-lib-ip=y
CONFIG_PACKAGE_luci-lib-jsonc=y
CONFIG_PACKAGE_luci-lib-nixio=y
CONFIG_PACKAGE_luci-lib-uqr=y
CONFIG_PACKAGE_luci-light=y
CONFIG_PACKAGE_luci-lua-runtime=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-proto-wireguard=n
CONFIG_PACKAGE_luci-theme-argon=n
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-app-athena-led=n
CONFIG_PACKAGE_luci-i18n-athena-led-zh-cn=n
CONFIG_PACKAGE_miniupnpd-nftables=n
# CONFIG_PACKAGE_mihomo-meta is not set
# CONFIG_PACKAGE_openclash is not set
CONFIG_PACKAGE_opkg=n                         # apk 已替代 opkg
CONFIG_PACKAGE_resolveip=y
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_rpcd-mod-file=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y
CONFIG_PACKAGE_rpcd-mod-luci=y
CONFIG_PACKAGE_rpcd-mod-rrdns=y
CONFIG_PACKAGE_rpcd-mod-ucode=y
CONFIG_PACKAGE_sing-box=n
CONFIG_PACKAGE_smartdns=n
CONFIG_PACKAGE_terminfo=y
CONFIG_PACKAGE_tini=y
CONFIG_PACKAGE_ttyd=n
# CONFIG_PACKAGE_ucode-mod-digest is not set
CONFIG_PACKAGE_ucode-mod-html=y
CONFIG_PACKAGE_ucode-mod-lua=y
CONFIG_PACKAGE_ucode-mod-math=y
# CONFIG_PACKAGE_ucode-mod-nl80211 is not set
# CONFIG_PACKAGE_ucode-mod-rtnl is not set
# CONFIG_PACKAGE_ucode-mod-uloop is not set
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
# CONFIG_PACKAGE_wifi-scripts is not set
CONFIG_PACKAGE_wireguard-tools=n
# CONFIG_PACKAGE_wireless-regdb is not set
# CONFIG_PACKAGE_wpad-openssl is not set
